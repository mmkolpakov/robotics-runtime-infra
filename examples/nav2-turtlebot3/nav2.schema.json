{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nav2-turtlebot3:scenario:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case",
    "goal",
    "action_budget_sec",
    "application_timeout_sec",
    "max_final_pose_error_m",
    "min_displacement_m",
    "max_observation_age_sec",
    "odometry_frame",
    "required_tf_edges"
  ],
  "properties": {
    "case": {
      "enum": [
        "success",
        "cancel",
        "timeout",
        "server-failure"
      ]
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -10,
          "maximum": 10
        },
        "y": {
          "type": "number",
          "minimum": -10,
          "maximum": 10
        }
      }
    },
    "action_budget_sec": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 180
    },
    "application_timeout_sec": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 180
    },
    "max_final_pose_error_m": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 2
    },
    "min_displacement_m": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 5
    },
    "max_observation_age_sec": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 5
    },
    "odometry_frame": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_/]{0,127}$"
    },
    "required_tf_edges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_/]{0,127}$"
        }
      }
    }
  }
}
