{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "name",
    "mode",
    "binding",
    "spool",
    "identity",
    "preflightImage",
    "deadlineSeconds",
    "terminationGracePeriodSeconds",
    "ttlSecondsAfterFinished",
    "host",
    "workers",
    "effectLease"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "name": {},
    "mode": {},
    "binding": {},
    "spool": {},
    "identity": {},
    "preflightImage": {},
    "deadlineSeconds": {},
    "terminationGracePeriodSeconds": {},
    "ttlSecondsAfterFinished": {},
    "host": {},
    "workers": {},
    "effectLease": {}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$"
          },
          "mode": {
            "enum": [
              "simulation",
              "export-recovery"
            ]
          },
          "binding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runId",
              "domainId",
              "profileId",
              "profileSha256"
            ],
            "properties": {
              "runId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "domainId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "profileId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "profileSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "spool": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "uid",
              "release",
              "storageClassName"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$"
              },
              "uid": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
              },
              "release": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$"
              },
              "storageClassName": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$"
              }
            }
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "serviceAccount",
              "namespace",
              "region",
              "bucket",
              "prefix"
            ],
            "properties": {
              "serviceAccount": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$"
              },
              "namespace": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$"
              },
              "region": {
                "type": "string",
                "minLength": 1
              },
              "bucket": {
                "type": "string",
                "minLength": 3
              },
              "prefix": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+(/[a-zA-Z0-9_-]+)*$"
              }
            }
          },
          "preflightImage": {
            "type": "string",
            "pattern": "^[^\\s]+@sha256:[a-f0-9]{64}$"
          },
          "deadlineSeconds": {
            "type": "integer",
            "minimum": 30,
            "maximum": 86400
          },
          "terminationGracePeriodSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "ttlSecondsAfterFinished": {
            "type": "integer",
            "minimum": 60,
            "maximum": 604800
          },
          "host": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "image": {
                "type": "string",
                "pattern": "^[^\\s]+@sha256:[a-f0-9]{64}$"
              },
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "uid": {
                "type": "integer",
                "minimum": 1000
              },
              "resources": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "requests",
                  "limits"
                ],
                "properties": {
                  "requests": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "cpu",
                      "memory"
                    ],
                    "properties": {
                      "cpu": {
                        "type": "string",
                        "minLength": 1
                      },
                      "memory": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "cpu",
                      "memory"
                    ],
                    "properties": {
                      "cpu": {
                        "type": "string",
                        "minLength": 1
                      },
                      "memory": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "image",
              "command",
              "args",
              "env",
              "uid",
              "resources"
            ]
          },
          "workers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": {
                  "type": "string",
                  "pattern": "^[^\\s]+@sha256:[a-f0-9]{64}$"
                },
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "uid": {
                  "type": "integer",
                  "minimum": 1000
                },
                "resources": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "requests",
                    "limits"
                  ],
                  "properties": {
                    "requests": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "cpu",
                        "memory"
                      ],
                      "properties": {
                        "cpu": {
                          "type": "string",
                          "minLength": 1
                        },
                        "memory": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "limits": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "cpu",
                        "memory"
                      ],
                      "properties": {
                        "cpu": {
                          "type": "string",
                          "minLength": 1
                        },
                        "memory": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                },
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$"
                },
                "ports": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "containerPort"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,14}$"
                      },
                      "containerPort": {
                        "type": "integer",
                        "minimum": 1024,
                        "maximum": 65535
                      }
                    }
                  }
                },
                "terminationCommand": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "image",
                "command",
                "args",
                "env",
                "uid",
                "resources",
                "name",
                "ports",
                "terminationCommand"
              ]
            }
          },
          "effectLease": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "uid"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$"
              },
              "uid": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          },
          "mode": {
            "const": "export-recovery"
          }
        }
      },
      "then": {
        "properties": {
          "workers": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
