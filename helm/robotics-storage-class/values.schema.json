{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "name": {
      "type": "string"
    },
    "identity": {
      "type": "object"
    }
  },
  "required": [
    "enabled",
    "name",
    "identity"
  ],
  "if": {
    "properties": {
      "enabled": {
        "const": true
      }
    }
  },
  "then": {
    "properties": {
      "name": {
        "pattern": "^[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$"
      },
      "identity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "namespace",
          "serviceAccount"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$"
          },
          "serviceAccount": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$"
          }
        }
      }
    }
  }
}
