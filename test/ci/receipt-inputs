#!/usr/bin/env bash
set -Eeuo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
test_python="$(dirname "${ROBOTICS_CONTRACTS_CLI:?installed contracts CLI is required}")/python"
if [[ -f "${test_python}.exe" ]]; then test_python+='.exe'; fi
exec "$test_python" "$root/docker/evidence-sink/receipt-inputs.py" "$@"
