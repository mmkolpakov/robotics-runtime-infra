{
  id: "2",
  mode: "client",
  connect: {
    endpoints: ["tcp/zenoh-source-plane:7447"],
  },
  scouting: {
    multicast: {
      enabled: false,
    },
    gossip: {
      enabled: false,
    },
  },
  plugins: {
    ros2dds: {
      nodename: "qualification_destination_bridge",
      domain: 32,
      ros_automatic_discovery_range: "LOCALHOST",
      allow: {
        publishers: ["^/robotics/qualification$"],
        subscribers: ["^/robotics/qualification$"],
        service_servers: [],
        service_clients: [],
        action_servers: [],
        action_clients: [],
      },
      reliable_routes_blocking: true,
    },
  },
}
