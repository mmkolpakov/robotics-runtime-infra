{
  "connect": {
    "endpoints": [
      "tcp/zenoh-source-plane:7447"
    ]
  },
  "id": "2",
  "mode": "client",
  "plugins": {
    "ros2dds": {
      "allow": {
        "action_clients": [],
        "action_servers": [],
        "publishers": [
          "^/robotics/trace_context$"
        ],
        "service_clients": [],
        "service_servers": [],
        "subscribers": [
          "^/robotics/trace_context$"
        ]
      },
      "domain": 32,
      "nodename": "trace_context_destination_bridge",
      "reliable_routes_blocking": true,
      "ros_automatic_discovery_range": "LOCALHOST"
    }
  },
  "scouting": {
    "gossip": {
      "enabled": false
    },
    "multicast": {
      "enabled": false
    }
  }
}
