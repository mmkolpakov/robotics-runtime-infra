{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^docker-bake\\.hcl$/"
      ],
      "matchStrings": [
        "variable \"COSIGN_IMAGE\" \\{\\s+default = \"(?<depName>cgr\\.dev/chainguard/cosign):(?<currentValue>latest)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track the source-built yq release and commit together",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG YQ_REVISION=(?<currentDigest>[a-f0-9]{40})\\r?\\nARG YQ_BASE_VERSION=(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "mikefarah/yq",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track foundation release tags and their immutable commits",
      "managerFilePatterns": ["/^foundation\\.repos$/"],
      "matchStrings": [
        "url: https://github\\.com/(?<depName>mmkolpakov/robotics-(?:runtime-contracts|acceptance-harness))\\.git\\r?\\n    # renovate: release=(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\r?\\n    version: (?<currentDigest>[a-f0-9]{40})"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update both version occurrences in foundation wheel input URLs",
      "managerFilePatterns": ["/^docker/python/(?:acceptance-observer|permit-preflight)\\.in$/"],
      "matchStrings": [
        "https://github\\.com/(?<depName>mmkolpakov/robotics-(?:runtime-contracts|acceptance-harness))/releases/download/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/(?<wheelName>robotics_(?:runtime_contracts|acceptance_harness))-\\d+\\.\\d+\\.\\d+-py3-none-any\\.whl"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "https://github.com/{{{depName}}}/releases/download/{{{newValue}}}/{{{replace '-' '_' (replace 'mmkolpakov/' '' depName)}}}-{{{replace '^v' '' newValue}}}-py3-none-any.whl"
    },
    {
      "customType": "regex",
      "description": "Update the CI contracts wheel URL and release-asset checksum together",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "https://github\\.com/(?<depName>mmkolpakov/robotics-runtime-contracts)/releases/download/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/robotics_runtime_contracts-\\d+\\.\\d+\\.\\d+-py3-none-any\\.whl#sha256=(?<currentDigest>[a-f0-9]{64})"
      ],
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "https://github.com/{{{depName}}}/releases/download/{{{newValue}}}/robotics_runtime_contracts-{{{replace '^v' '' newValue}}}-py3-none-any.whl#sha256={{{newDigest}}}"
    },
    {
      "customType": "regex",
      "description": "Track the Cosign version paired with the container digest",
      "managerFilePatterns": ["/^docker-bake\\.hcl$/"],
      "matchStrings": ["variable \"COSIGN_VERSION\" \\{\\s+default = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "sigstore/cosign",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Review foundation updates as one compatibility change; refresh locks before merging",
      "matchPackageNames": [
        "mmkolpakov/robotics-runtime-contracts",
        "mmkolpakov/robotics-acceptance-harness"
      ],
      "groupName": "foundation releases",
      "groupSlug": "foundation-releases",
      "separateMajorMinor": false,
      "automerge": false,
      "prBodyNotes": [
        "Refresh docker/python/*.lock, tooling/foundation/uv.lock and docs/foundation-compatibility.md; verify release tags, wheel versions and SHA-256 values together. Run foundation-integration before merging. The current 0.15.4/0.17.1 pair is incompatible with contracts 0.16 / harness 0.18; see docs/compatibility.md."
      ]
    },
    {
      "description": "Keep the Cosign image, build version and installer inputs in one reviewed update",
      "matchPackageNames": ["cgr.dev/chainguard/cosign", "sigstore/cosign"],
      "groupName": "cosign",
      "minimumReleaseAge": "0 days",
      "automerge": false
    },
    {
      "description": "Do not restore Cosign releases affected by GHSA-fx35-mq7g-6g98",
      "matchPackageNames": ["sigstore/cosign"],
      "allowedVersions": ">=3.1.3"
    },
    {
      "description": "Keep runtime and CI dependencies reproducible",
      "matchManagers": [
        "docker-compose",
        "dockerfile",
        "github-actions"
      ],
      "rangeStrategy": "pin"
    },
    {
      "description": "Qualify every Chainguard Cosign rebuild",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "cgr.dev/chainguard/cosign"
      ],
      "minimumReleaseAge": "0 days",
      "automerge": false,
      "labels": [
        "supply-chain"
      ]
    },
    {
      "description": "Do not restore yq releases affected by CVE-2026-56852",
      "matchDepNames": [
        "mikefarah/yq"
      ],
      "allowedVersions": ">=4.53.4"
    }
  ]
}
