{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the rclone release tag and verified source commit together",
      "managerFilePatterns": [
        "/^docker-bake\\.hcl$/"
      ],
      "matchStrings": [
        "variable \"RCLONE_REVISION\" \\{\\s+default = \"(?<currentDigest>[a-f0-9]{40})\"[\\s\\S]*?variable \"RCLONE_VERSION\" \\{\\s+default = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "rclone/rclone",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track the source-built yq release and commit together",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG YQ_REVISION=(?<currentDigest>[a-f0-9]{40})\\r?\\nARG YQ_BASE_VERSION=(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "mikefarah/yq",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track the Cosign release tag and verified source commit together",
      "managerFilePatterns": [
        "/^docker-bake\\.hcl$/"
      ],
      "matchStrings": [
        "variable \"COSIGN_REVISION\" \\{\\s+default = \"(?<currentDigest>[a-f0-9]{40})\"[\\s\\S]*?variable \"COSIGN_VERSION\" \\{\\s+default = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "sigstore/cosign",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Freeze the Zenoh bridge baseline until transport equivalence is qualified",
      "matchFileNames": ["test/compose/compose.zenoh.yaml"],
      "matchPackageNames": ["eclipse/zenoh-bridge-ros2dds"],
      "enabled": false
    },
    {
      "description": "Keep the Cosign source and installer version in one reviewed update",
      "matchPackageNames": [
        "sigstore/cosign"
      ],
      "groupName": "cosign",
      "minimumReleaseAge": "0 days",
      "automerge": false
    },
    {
      "description": "Do not restore Cosign releases affected by GHSA-fx35-mq7g-6g98",
      "matchPackageNames": [
        "sigstore/cosign"
      ],
      "allowedVersions": ">=3.1.3"
    },
    {
      "description": "Keep runtime and CI dependencies reproducible",
      "matchManagers": [
        "docker-compose",
        "dockerfile",
        "github-actions"
      ],
      "rangeStrategy": "pin"
    },
    {
      "description": "Do not restore yq releases affected by CVE-2026-56852",
      "matchDepNames": [
        "mikefarah/yq"
      ],
      "allowedVersions": ">=4.53.4"
    }
  ]
}
