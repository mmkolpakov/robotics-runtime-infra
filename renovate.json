{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "timezone": "Etc/UTC",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "rebaseWhen": "conflicted",
  "customManagers": [
    {
      "customType": "jsonata",
      "description": "Track the published harness release and immutable foundation workspace commit",
      "managerFilePatterns": [
        "/^foundation\\.repos$/"
      ],
      "fileFormat": "json",
      "matchStrings": [
        "repositories.\"robotics-runtime\"[type = 'git' and url = 'https://github.com/mmkolpakov/robotics-runtime.git'][$type(release) = 'string' and $type(version) = 'string'][$match(release, /^harness-v[0-9]+\\.[0-9]+\\.[0-9]+$/) and $match(version, /^[a-f0-9]{40}$/)].{'depName': 'mmkolpakov/robotics-runtime', 'currentValue': release, 'currentDigest': version}"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^harness-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Track the publisher-verified Cosign image used by Docker Bake",
      "managerFilePatterns": [
        "/^docker-bake\\.hcl$/"
      ],
      "matchStrings": [
        "variable \"COSIGN_IMAGE\" \\{\\s+default = \"(?<depName>cgr\\.dev/chainguard/cosign):(?<currentValue>latest)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track the source-built yq release and commit together",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG YQ_REVISION=(?<currentDigest>[a-f0-9]{40})\\r?\\nARG YQ_BASE_VERSION=(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "mikefarah/yq",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track the Cosign version required by the installed binary check",
      "managerFilePatterns": [
        "/^docker-bake\\.hcl$/"
      ],
      "matchStrings": [
        "variable \"COSIGN_VERSION\" \\{\\s+default = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "sigstore/cosign",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track digest-pinned tool images in workflow environments and local actions",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^\\.github/actions/[^/]+/action\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:[A-Z0-9_]+_IMAGE:|image[=:])\\s*(?:docker\\.io/)?(?<depName>[a-z0-9][a-z0-9._/-]*):(?<currentValue>[A-Za-z0-9][A-Za-z0-9._-]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Qualify the foundation release pair after regenerating its derived inputs",
      "matchManagers": [
        "custom.jsonata"
      ],
      "matchFileNames": [
        "foundation.repos"
      ],
      "matchPackageNames": [
        "mmkolpakov/robotics-runtime"
      ],
      "ignoreUnstable": true,
      "automerge": false,
      "prBodyNotes": [
        "Run `bash scripts/ci/foundation/import-sources.sh --refresh-pins` on this branch and include the generated inputs before merging. Published contracts/harness compatibility and foundation qualification remain required; see test/renovate/README.md."
      ]
    },
    {
      "description": "Keep OPA above the Go, crypto and gRPC fixes verified for CI 34305345505",
      "matchDepNames": [
        "openpolicyagent/opa"
      ],
      "matchDatasources": [
        "docker"
      ],
      "versionCompatibility": "^(?<version>\\d+\\.\\d+\\.\\d+)(?<compatibility>-static)$",
      "versioning": "semver",
      "allowedVersions": ">=1.20.2"
    },
    {
      "description": "Keep the Cosign image, binary check and installer version in one reviewed update",
      "matchPackageNames": [
        "sigstore/cosign",
        "cgr.dev/chainguard/cosign"
      ],
      "groupName": "cosign",
      "minimumReleaseAge": "0 days",
      "automerge": false
    },
    {
      "description": "Do not restore Cosign releases affected by GHSA-fx35-mq7g-6g98",
      "matchPackageNames": [
        "sigstore/cosign"
      ],
      "allowedVersions": ">=3.1.3"
    },
    {
      "description": "Keep runtime and CI dependencies reproducible",
      "matchManagers": [
        "docker-compose",
        "dockerfile",
        "github-actions"
      ],
      "rangeStrategy": "pin"
    },
    {
      "description": "Do not restore yq releases affected by CVE-2026-56852",
      "matchDepNames": [
        "mikefarah/yq"
      ],
      "allowedVersions": ">=4.53.4"
    },
    {
      "description": "Batch digest refreshes into one weekly PR",
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "groupName": "digest refreshes"
    },
    {
      "description": "Batch minor and patch releases into one weekly PR",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "minor and patch releases"
    },
    {
      "description": "Batch GitHub Actions updates of any kind except major releases",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "minor",
        "patch"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Qualify every Chainguard Cosign rebuild",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "cgr.dev/chainguard/cosign"
      ],
      "groupName": "cosign",
      "minimumReleaseAge": "0 days",
      "automerge": false,
      "labels": [
        "supply-chain"
      ]
    },
    {
      "description": "ROS 2 Jazzy targets Ubuntu 24.04; a newer series needs a newer ROS distribution",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "ubuntu"
      ],
      "allowedVersions": "/^24\\.04$/"
    },
    {
      "description": "RKNN Toolkit2 2.3.2 ships CPython 3.12 wheels for the Debian bookworm converter",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "/^3\\.12-slim-bookworm$/"
    }
  ],
  "automerge": false
}
