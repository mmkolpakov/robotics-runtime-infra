#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$script_dir/lib.sh"

usage() {
  cat >&2 <<'EOF'
usage: create-statement
  --scenario PATH
  --runtime-manifest DOMAIN=PATH [--runtime-manifest DOMAIN=PATH ...]
  --acceptance-run PATH
  --result DOMAIN=PATH [--result DOMAIN=PATH ...]
  --aggregate PATH
  [--transport-qualification PATH]
  --evidence-index DOMAIN=PATH [--evidence-index DOMAIN=PATH ...]
  --recording-summary LABEL=PATH [--recording-summary LABEL=PATH ...]
  [--extension-schema URI=PATH ...]
  [--evidence KIND:LABEL=PATH ...]

Alternatively supply the complete inventory with repeated --artifact KIND:SUBJECT=PATH.
Named options and native artifact arguments may be combined.
  --output PATH

Optional evidence KIND is one of:
  metrics, traces, junit, causal_chain_contract, channel_contract,
  channel_observation, model_manifest, dataset_manifest, execution_permit,
  execution_verification, policy, recording, other_evidence, clock_relation, qualification_profile,
  provider_conformance, artifact_receipt, artifact_verification, attestation,
  verification, package
EOF
  exit 64
}

qualification_parse_cli create "$@"
qualification_prepare
# shellcheck disable=SC2154
qualification_write_statement "$output"
