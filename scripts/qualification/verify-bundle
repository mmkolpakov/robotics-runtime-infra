#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$script_dir/lib.sh"

QUALIFICATION_PREDICATE_TYPE='https://robotics-runtime-contracts.dev/attestations/qualification-bundle/v1'

usage() {
  cat >&2 <<'EOF'
usage: verify-bundle
  --bundle PATH
  (--key PATH | --trusted-root PATH --policy PATH)
  --scenario PATH
  --runtime-manifest DOMAIN=PATH [--runtime-manifest DOMAIN=PATH ...]
  --acceptance-run PATH
  --result DOMAIN=PATH [--result DOMAIN=PATH ...]
  --aggregate PATH
  [--transport-qualification PATH]
  --evidence-index DOMAIN=PATH [--evidence-index DOMAIN=PATH ...]
  --recording-summary LABEL=PATH [--recording-summary LABEL=PATH ...]
  [--extension-schema URI=PATH ...]
  [--evidence KIND:LABEL=PATH ...]

Alternatively supply the complete inventory with repeated --artifact KIND:SUBJECT=PATH.
Named options and native artifact arguments may be combined.

Optional evidence KIND is one of:
  metrics, traces, junit, causal_chain_contract, channel_contract,
  channel_observation, model_manifest, dataset_manifest, execution_permit,
  execution_verification, policy, recording, other_evidence, clock_relation, qualification_profile,
  provider_conformance, artifact_receipt, artifact_verification, attestation,
  verification, package
EOF
  exit 64
}

qualification_parse_cli verify "$@"
qualification_require_command cosign
qualification_require_command base64
qualification_require_command sha256sum
qualification_prepare
work="$(mktemp -d)"
trap 'qualification_cleanup "$work"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
# shellcheck disable=SC2154
qualification_require_file "$bundle"
cp -- "$bundle" "$work/bundle.json"
bundle="$work/bundle.json"
jq --slurp --exit-status 'length == 1' "$bundle" >/dev/null ||
  qualification_fail "expected exactly one JSON document: $bundle"
if [[ -n "$verification_key" ]]; then
  [[ -z "$trusted_root" && -z "$policy" ]] ||
    qualification_fail \
      '--key is mutually exclusive with --trusted-root and --policy'
  qualification_require_file "$verification_key"
  cp -- "$verification_key" "$work/public.key"
  verification_key="$work/public.key"
else
  [[ -n "$trusted_root" && -n "$policy" ]] ||
    qualification_fail \
      'identity verification requires --trusted-root and --policy'
  qualification_require_file "$trusted_root"
  qualification_require_file "$policy"
  cp -- "$trusted_root" "$work/trusted-root.json"
  cp -- "$policy" "$work/policy.json"
  trusted_root="$work/trusted-root.json"
  policy="$work/policy.json"
  qualification_validate_contract "$policy" qualification-policy.v1
  [[ "$(qualification_sha256 "$trusted_root")" == \
    "$(jq -er '.trusted_root_sha256' "$policy")" ]] ||
    qualification_fail 'trusted root digest does not match qualification policy'
  [[ "$(jq -er '.predicate_type' "$policy")" == \
    "$QUALIFICATION_PREDICATE_TYPE" ]] ||
    qualification_fail 'qualification policy has an unsupported predicate type'
fi

qualification_write_statement "$work/expected-statement.json"

aggregate_sha256="$(jq -er '
  . as $statement
  | .predicate.artifacts[]
  | select(.kind == "acceptance_aggregate")
  | .subject_name as $name
  | $statement.subject[] | select(.name == $name) | .digest.sha256
' "$work/expected-statement.json")"
verified_identity=''
if [[ -n "$verification_key" ]]; then
  cosign verify-blob-attestation \
    --bundle "$bundle" \
    --key "$verification_key" \
    --insecure-ignore-tlog \
    --digest "$aggregate_sha256" \
    --digestAlg sha256 \
    --type "$QUALIFICATION_PREDICATE_TYPE" >/dev/null ||
    qualification_fail 'Sigstore verification failed for the supplied public key'
  verified_identity="key-sha256:$(qualification_sha256 "$verification_key")"
else
  missing_kinds="$(
    jq -n -r \
      --slurpfile policy "$policy" \
      --slurpfile statement "$work/expected-statement.json" '
        ($policy[0].required_artifact_kinds -
          ($statement[0].predicate.artifacts | map(.kind) | unique))[]
      '
  )"
  [[ -z "$missing_kinds" ]] ||
    qualification_fail \
      "statement is missing policy-required artifact kinds: $missing_kinds"

  issuer="$(jq -er '.certificate_oidc_issuer' "$policy")"
  predicate_type="$(jq -er '.predicate_type' "$policy")"
  while IFS= read -r identity; do
    if cosign verify-blob-attestation \
      --bundle "$bundle" \
      --trusted-root "$trusted_root" \
      --certificate-identity "$identity" \
      --certificate-oidc-issuer "$issuer" \
      --digest "$aggregate_sha256" \
      --digestAlg sha256 \
      --type "$predicate_type" >/dev/null; then
      verified_identity="$identity"
      break
    fi
  done < <(jq -er '.certificate_identities[]' "$policy")
  [[ -n "$verified_identity" ]] ||
    qualification_fail \
      'Sigstore verification failed for every trusted certificate identity'
fi

[[ "$(jq -r '.mediaType' "$bundle")" == \
  application/vnd.dev.sigstore.bundle.v0.3+json ]] ||
  qualification_fail 'unsupported Sigstore bundle media type'
[[ "$(jq -r '.dsseEnvelope.payloadType' "$bundle")" == \
  application/vnd.in-toto+json ]] ||
  qualification_fail 'Sigstore bundle does not contain an in-toto DSSE envelope'
jq -er '.dsseEnvelope.payload' "$bundle" |
  base64 --decode >"$work/verified-statement.json" ||
  qualification_fail 'Sigstore bundle contains an invalid DSSE payload'
qualification_match_statement "$work/verified-statement.json"

printf 'qualification bundle verified for %s as %s\n' \
  "$(jq -er '.predicate.run_id' "$work/expected-statement.json")" "$verified_identity"
