#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

fail() {
  printf 'create-acceptance-run: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat >&2 <<'EOF'
usage: create-acceptance-run --scenario PATH --scenario-id ID --output PATH
       --domain ID=ROLE [--domain ID=ROLE ...]
       --time-authority KIND --time-source ID
EOF
  exit 2
}

scenario=''
scenario_id=''
output=''
time_authority=''
time_source=''
domains=()

while (($# > 0)); do
  case "$1" in
    --scenario)
      (($# >= 2)) || usage
      scenario="$2"
      shift 2
      ;;
    --scenario-id)
      (($# >= 2)) || usage
      scenario_id="$2"
      shift 2
      ;;
    --output)
      (($# >= 2)) || usage
      output="$2"
      shift 2
      ;;
    --domain)
      (($# >= 2)) || usage
      domains+=("$2")
      shift 2
      ;;
    --time-authority)
      (($# >= 2)) || usage
      time_authority="$2"
      shift 2
      ;;
    --time-source)
      (($# >= 2)) || usage
      time_source="$2"
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done

[[ -f "$scenario" ]] || fail "scenario does not exist: $scenario"
[[ -n "$scenario_id" ]] || fail '--scenario-id is required'
[[ -n "$output" ]] || fail '--output is required'
[[ -n "$time_authority" ]] || fail '--time-authority is required'
[[ -n "$time_source" ]] || fail '--time-source is required'
((${#domains[@]} > 0)) || fail 'at least one --domain is required'
command -v jq >/dev/null 2>&1 || fail 'jq is required'
command -v sha256sum >/dev/null 2>&1 || fail 'sha256sum is required'

identifier_pattern='^[a-z][a-z0-9]*([._-][a-z0-9]+)*$'
[[ "$scenario_id" =~ $identifier_pattern ]] || fail 'scenario ID is invalid'
[[ "$time_source" =~ $identifier_pattern ]] || fail 'time source ID is invalid'
case "$time_authority" in
  sim_clock | playback_clock | ptp | chrony_ntp | mavlink_timesync | external) ;;
  *) fail "unsupported time authority: $time_authority" ;;
esac

run_id="${ROBOTICS_RUN_ID:-run-$(tr '[:upper:]' '[:lower:]' </proc/sys/kernel/random/uuid)}"
[[ "$run_id" =~ ^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]] || \
  fail 'ROBOTICS_RUN_ID must use canonical run-<uuid4> form'

domains_json='[]'
for specification in "${domains[@]}"; do
  domain_id="${specification%%=*}"
  role="${specification#*=}"
  [[ "$specification" == *=* && -n "$domain_id" && -n "$role" ]] || \
    fail "invalid domain specification: $specification"
  [[ "$domain_id" =~ $identifier_pattern ]] || fail "invalid domain ID: $domain_id"
  [[ "$role" =~ $identifier_pattern ]] || fail "invalid domain role: $role"
  domains_json="$(
    jq -c --arg domain_id "$domain_id" --arg role "$role" \
      '. + [{domain_id: $domain_id, role: $role}]' <<<"$domains_json"
  )"
done
[[ "$(jq '[.[].domain_id] | unique | length == length' <<<"$domains_json")" == true ]] || \
  fail 'domain IDs must be unique'

scenario_sha256="$(sha256sum "$scenario" | cut -d' ' -f1)"
created_at="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
mkdir -p "$(dirname "$output")"
temporary="$(mktemp "$(dirname "$output")/.acceptance-run.XXXXXX")"
trap 'rm -f "$temporary"' EXIT
jq -n \
  --arg run_id "$run_id" \
  --arg created_at "$created_at" \
  --arg scenario_id "$scenario_id" \
  --arg scenario_sha256 "$scenario_sha256" \
  --arg authority_kind "$time_authority" \
  --arg source_id "$time_source" \
  --argjson domains "$domains_json" \
  '{
    schema_version: "acceptance-run.v1",
    run_id: $run_id,
    created_at: $created_at,
    scenario_id: $scenario_id,
    scenario_sha256: $scenario_sha256,
    time_authority: {
      kind: $authority_kind,
      source_id: $source_id
    },
    domains: $domains
  }' >"$temporary"
chmod 0444 "$temporary"
mv "$temporary" "$output"
trap - EXIT
printf '%s\n' "$run_id"
