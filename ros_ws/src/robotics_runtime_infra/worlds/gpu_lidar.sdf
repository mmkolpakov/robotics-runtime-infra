<?xml version="1.0"?>
<sdf version="1.10">
  <world name="gpu_lidar">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="lidar_probe">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>
      <link name="lidar_link">
        <sensor name="gpu_lidar" type="gpu_lidar">
          <always_on>true</always_on>
          <update_rate>20</update_rate>
          <topic>/gpu_lidar/scan</topic>
          <gz_frame_id>lidar_link</gz_frame_id>
          <lidar>
            <scan>
              <horizontal>
                <samples>640</samples>
                <resolution>1</resolution>
                <min_angle>-1.57079632679</min_angle>
                <max_angle>1.57079632679</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.1</min>
              <max>20</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
        </sensor>
      </link>
    </model>

    <model name="lidar_target">
      <static>true</static>
      <pose>3 0 0.5 0 0 0</pose>
      <link name="target_link">
        <collision name="target_collision">
          <geometry><box><size>1 1 1</size></box></geometry>
        </collision>
        <visual name="target_visual">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material><diffuse>0.1 0.7 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
