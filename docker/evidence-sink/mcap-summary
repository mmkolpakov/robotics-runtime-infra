#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -ne 2 ]]; then
  printf 'usage: mcap-summary SOURCE DESTINATION\n' >&2
  exit 64
fi
source_path="$1"
destination="$2"
contracts_cli="${ROBOTICS_CONTRACTS_CLI:-robotics-contracts}"
if [[ "$source_path" -ef "$destination" ]]; then
  printf 'mcap-summary: destination must not replace source\n' >&2
  exit 65
fi
mkdir -p "$(dirname "$destination")"
staged="$(mktemp "$(dirname "$destination")/.recording-summary.XXXXXX")"
trap 'rm -f -- "$staged"' EXIT
"$contracts_cli" recording-summary from-mcap "$source_path" --output "$staged" >/dev/null
chmod 0444 "$staged"
mv -f -- "$staged" "$destination"
