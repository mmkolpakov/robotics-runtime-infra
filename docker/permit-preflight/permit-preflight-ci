#!/bin/sh
set -eu

# shellcheck source=docker/permit-preflight/core.sh
. /usr/local/lib/robotics-runtime/permit-preflight-core.sh

usage() {
  cat >&2 <<'EOF'
usage:
  permit-preflight-ci verify-offline-test-attestation STATEMENT BUNDLE PUBLIC_KEY
  permit-preflight-ci authorize-logged-test PUBLIC_KEY_DIR PERMIT STATEMENT OPERATOR_BUNDLE APPROVER_BUNDLE TRUST_POLICY REQUEST NONCE_DIR OUTPUT
  permit-preflight-ci authorize-offline-test PUBLIC_KEY_DIR PERMIT STATEMENT OPERATOR_BUNDLE APPROVER_BUNDLE TRUST_POLICY REQUEST NONCE_DIR OUTPUT
EOF
  exit 64
}

verify_offline_attestation() {
  statement="$1"
  bundle="$2"
  public_key="$3"
  decoded_statement="$4"
  assert_single_json_document "${statement}"
  assert_single_json_document "${bundle}"
  digest="$(statement_subject_digest "${statement}")"
  predicate_type="$(execution_permit_predicate_type "${statement}")"
  cosign verify-blob-attestation \
    --bundle "${bundle}" \
    --key "${public_key}" \
    --insecure-ignore-tlog \
    --digest "${digest}" \
    --digestAlg sha256 \
    --type "${predicate_type}" || {
    printf 'offline attestation signature verification failed: %s\n' \
      "${bundle}" >&2
    exit 65
  }
  assert_bundle_statement "${statement}" "${bundle}" "${decoded_statement}"
}

verify_logged_attestation() {
  statement="$1"
  bundle="$2"
  public_key="$3"
  decoded_statement="$4"
  trusted_root=/usr/share/robotics-runtime/trust/sigstore-trusted-root.json
  require_file "${trusted_root}"
  assert_single_json_document "${statement}"
  assert_single_json_document "${bundle}"
  digest="$(statement_subject_digest "${statement}")"
  predicate_type="$(execution_permit_predicate_type "${statement}")"
  cosign verify-blob-attestation \
    --bundle "${bundle}" \
    --key "${public_key}" \
    --trusted-root "${trusted_root}" \
    --digest "${digest}" \
    --digestAlg sha256 \
    --type "${predicate_type}" || {
    printf 'logged attestation verification failed: %s\n' "${bundle}" >&2
    exit 65
  }
  assert_bundle_statement "${statement}" "${bundle}" "${decoded_statement}"
}

verify_role_attestation() {
  test "$#" -eq 6 || usage
  role="$1"
  statement="$2"
  bundle="$3"
  decoded_statement="$6"
  case "${role}" in
    operator | approver) ;;
    *) usage ;;
  esac
  # Ephemeral CI keys identify only the explicitly named synthetic principals.
  # They must never be reported as a Fulcio/OIDC identity from an input permit.
  test "$4" = "ci.${role}" &&
    test "$5" = https://github.com/sigstore/cosign/key || {
    printf 'keyed CI verification requires the synthetic %s principal\n' "${role}" >&2
    exit 65
  }
  case "${ci_authorization_mode}" in
    authorize-logged-test) role_verifier=verify_logged_attestation ;;
    authorize-offline-test) role_verifier=verify_offline_attestation ;;
    *) usage ;;
  esac
  "${role_verifier}" \
    "${statement}" \
    "${bundle}" \
    "${ci_key_dir}/${role}.pub" \
    "${decoded_statement}"
}

command_name="${1:-}"
case "${command_name}" in
  authorize-logged-test | authorize-offline-test)
    test "$#" -eq 10 || usage
    shift
    ci_authorization_mode="${command_name}"
    ci_key_dir="$1"
    shift
    test -d "${ci_key_dir}" && test ! -L "${ci_key_dir}" || {
      printf 'CI key directory must be a non-symlink directory\n' >&2
      exit 66
    }
    require_file "${ci_key_dir}/operator.pub"
    require_file "${ci_key_dir}/approver.pub"
    authorize_common "$@"
    ;;
  verify-offline-test-attestation)
    test "$#" -eq 4 || usage
    statement="$2"
    bundle="$3"
    public_key="$4"
    require_file "${statement}"
    require_file "${bundle}"
    require_file "${public_key}"
    work="$(mktemp -d)"
    trap 'rm -rf "${work}"' EXIT HUP INT TERM
    verify_offline_attestation \
      "${statement}" \
      "${bundle}" \
      "${public_key}" \
      "${work}/statement.json"
    ;;
  versions | authorize | materialize-runtime)
    exec /usr/local/bin/permit-preflight "$@"
    ;;
  *)
    usage
    ;;
esac
