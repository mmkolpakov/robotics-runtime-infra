#!/bin/sh
set -eu

# shellcheck source=docker/permit-preflight/core.sh
. /usr/local/lib/robotics-runtime/permit-preflight-core.sh

usage() {
  cat >&2 <<'EOF'
usage:
  permit-preflight versions
  permit-preflight authorize PERMIT STATEMENT OPERATOR_BUNDLE APPROVER_BUNDLE TRUST_POLICY REQUEST NONCE_DIR OUTPUT
  permit-preflight materialize-runtime TEMPLATE PERMIT VERIFICATION TRUST_POLICY OUTPUT
EOF
  exit 64
}

verify_role_attestation() {
  test "$#" -eq 6 || usage
  role="$1"
  statement="$2"
  bundle="$3"
  identity="$4"
  issuer="$5"
  decoded_statement="$6"
  case "${role}" in
    operator | approver) ;;
    *) usage ;;
  esac
  trusted_root=/usr/share/robotics-runtime/trust/sigstore-trusted-root.json
  require_file "${trusted_root}"
  assert_single_json_document "${statement}"
  assert_single_json_document "${bundle}"
  digest="$(statement_subject_digest "${statement}")"
  predicate_type="$(execution_permit_predicate_type "${statement}")"
  cosign verify-blob-attestation \
    --bundle "${bundle}" \
    --trusted-root "${trusted_root}" \
    --certificate-identity "${identity}" \
    --certificate-oidc-issuer "${issuer}" \
    --digest "${digest}" \
    --digestAlg sha256 \
    --type "${predicate_type}"
  assert_bundle_statement "${statement}" "${bundle}" "${decoded_statement}"
}

command_name="${1:-}"
case "${command_name}" in
  versions)
    test "$#" -eq 1 || usage
    cosign version
    opa version
    jq --version
    exec python3 -c \
      'from importlib.metadata import version; print("robotics-runtime-contracts", version("robotics-runtime-contracts"))'
    ;;
  authorize)
    test "$#" -eq 9 || usage
    shift
    authorize_common "$@"
    ;;
  materialize-runtime)
    test "$#" -eq 6 || usage
    shift
    materialize_runtime "$@"
    ;;
  *)
    usage
    ;;
esac
