#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

fail() {
  printf 'emit-runtime-manifest: %s\n' "$*" >&2
  exit 1
}

required() {
  [[ -n "${!1:-}" ]] || fail "$1 is required"
}

boolean() {
  case "$1" in
    true | false) printf '%s\n' "$1" ;;
    *) fail "expected true or false, received: $1" ;;
  esac
}

for variable in \
  ROBOTICS_RUNTIME_ID \
  ROBOTICS_OCI_REFERENCE \
  ROBOTICS_OCI_DIGEST \
  ROBOTICS_INFRA_REVISION \
  ROBOTICS_HOST_PLATFORM_FILE \
  ROBOTICS_PROVIDER_BINDINGS_FILE \
  ROS_DISTRO; do
  required "$variable"
done

foundation_lock="${ROBOTICS_FOUNDATION_LOCK:-/usr/share/robotics-runtime/foundation-lock.json}"
[[ -r "$foundation_lock" ]] || fail "foundation lock is not readable: $foundation_lock"

workspace_revision="$(
  jq -er '.repositories["robotics-runtime"].version' "$foundation_lock"
)"
[[ "$workspace_revision" =~ ^[0-9a-f]{40}$ ]] || fail 'foundation revision must be a full Git SHA'
contracts_cli="${ROBOTICS_CONTRACTS_CLI:-robotics-contracts}"
command -v "${contracts_cli}" >/dev/null 2>&1 || fail 'contracts CLI is unavailable'
jq -e -s 'length == 1 and (.[0] | type == "object")' \
  "${ROBOTICS_HOST_PLATFORM_FILE}" >/dev/null || fail 'expected one host platform object'
jq -e -s 'length == 1 and (.[0] | type == "array")' \
  "${ROBOTICS_PROVIDER_BINDINGS_FILE}" >/dev/null || fail 'expected one provider bindings array'
evaluator_bindings='[]'
if [[ -n "${ROBOTICS_EVALUATOR_BINDINGS_FILE:-}" ]]; then
  evaluator_bindings="$(jq -c -s 'if length == 1 and (.[0] | type == "array") then .[0]
    else error("expected one evaluator bindings array") end' "${ROBOTICS_EVALUATOR_BINDINGS_FILE}")"
fi
rmw="${RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}"
[[ "${rmw}" =~ ^rmw_[a-z0-9_]+$ && "${ROS_DISTRO}" =~ ^[a-z][a-z0-9_-]*$ ]] || \
  fail 'invalid ROS distribution or RMW package name'
rmw_version="$(ros2 pkg xml "${rmw}" --tag version)"
[[ -n "${rmw_version}" && "${rmw_version}" != *$'\n'* ]] || \
  fail 'active RMW package must report exactly one version'
domain_id="${ROS_DOMAIN_ID:-0}"
[[ "${domain_id}" =~ ^[0-9]+$ && "${#domain_id}" -le 3 ]] || fail 'invalid ROS_DOMAIN_ID'
domain_id="$((10#${domain_id}))"

[[ "${ROBOTICS_OCI_REFERENCE}" == *@"${ROBOTICS_OCI_DIGEST}" ]] || \
  fail 'ROBOTICS_OCI_REFERENCE must end with ROBOTICS_OCI_DIGEST'
workload_kind="${ROBOTICS_WORKLOAD_KIND:-none}"
case "${workload_kind}" in
  none)
    workload='{"kind":"none"}'
    ;;
  inference)
    for variable in \
      ROBOTICS_MODEL_MANIFEST_SHA256 \
      ROBOTICS_MODEL_ARTIFACT_SHA256 \
      ROBOTICS_MODEL_FORMAT \
      ROBOTICS_INFERENCE_RUNTIME_FAMILY \
      ROBOTICS_INFERENCE_RUNTIME_VERSION \
      ROBOTICS_REQUESTED_PROVIDER \
      ROBOTICS_ACTUAL_PROVIDER \
      ROBOTICS_FALLBACK_COUNT \
      ROBOTICS_ACCELERATOR_VENDOR \
      ROBOTICS_ACCELERATOR_DEVICE_CLASS \
      ROBOTICS_ACCELERATOR_DEVICE_ID; do
      required "$variable"
    done
    [[ "${ROBOTICS_FALLBACK_COUNT}" =~ ^[0-9]+$ ]] || \
      fail 'ROBOTICS_FALLBACK_COUNT must be a non-negative integer'
    workload="$(jq -cS -n \
      --arg model_manifest_sha256 "${ROBOTICS_MODEL_MANIFEST_SHA256}" \
      --arg model_artifact_sha256 "${ROBOTICS_MODEL_ARTIFACT_SHA256}" \
      --arg model_format "${ROBOTICS_MODEL_FORMAT}" \
      --arg runtime_family "${ROBOTICS_INFERENCE_RUNTIME_FAMILY}" \
      --arg runtime_version "${ROBOTICS_INFERENCE_RUNTIME_VERSION}" \
      --arg requested_provider "${ROBOTICS_REQUESTED_PROVIDER}" \
      --arg actual_provider "${ROBOTICS_ACTUAL_PROVIDER}" \
      --argjson fallback_count "${ROBOTICS_FALLBACK_COUNT}" \
      --arg accelerator_vendor "${ROBOTICS_ACCELERATOR_VENDOR}" \
      --arg accelerator_device_class "${ROBOTICS_ACCELERATOR_DEVICE_CLASS}" \
      --arg accelerator_device_id "${ROBOTICS_ACCELERATOR_DEVICE_ID}" \
      --arg openvino_version "${ROBOTICS_OPENVINO_VERSION:-}" \
      '{
        kind: "inference",
        model: {
          manifest_sha256: $model_manifest_sha256,
          artifact_sha256: $model_artifact_sha256,
          format: $model_format
        },
        inference: {
          runtime_family: $runtime_family,
          runtime_version: $runtime_version,
          requested_provider: $requested_provider,
          actual_provider: $actual_provider,
          fallback_count: $fallback_count
        },
        accelerator: ({
          vendor: $accelerator_vendor,
          device_class: $accelerator_device_class,
          device_id: $accelerator_device_id
        } + if $openvino_version == "" then {}
          else {software_components: [{component_id: "openvino", version: $openvino_version}]} end)
      }')"
    ;;
  *)
    fail "unsupported ROBOTICS_WORKLOAD_KIND: ${workload_kind}"
    ;;
esac

architecture="$(uname -m)"
case "$architecture" in
  x86_64 | aarch64 | arm64) ;;
  *) fail "unsupported runtime architecture: $architecture" ;;
esac

kernel="$(uname -r)"
# This is the container platform; the host is supplied by the host-side runner.
# shellcheck source=/dev/null
source /etc/os-release
execution_os="${ID}"
execution_os_version="${VERSION_ID}"

shm_transport="$(boolean "${ROBOTICS_SHM_TRANSPORT:-false}")"
data_sharing="$(boolean "${ROBOTICS_DATA_SHARING:-false}")"
private_ipc="$(boolean "${ROBOTICS_PRIVATE_IPC:-false}")"

configuration_artifacts='[]'
append_configuration_artifact() {
  local kind="$1"
  local path="$2"
  local digest
  [[ -z "${path}" ]] && return
  [[ -r "${path}" ]] || fail "${kind} configuration is not readable: ${path}"
  digest="$(sha256sum "${path}" | cut -d' ' -f1)"
  configuration_artifacts="$(
    jq -c --arg kind "${kind}" --arg sha256 "${digest}" \
      '. + [{kind: $kind, sha256: $sha256}]' \
      <<<"${configuration_artifacts}"
  )"
}

append_configuration_artifact \
  inference_provider "${ROBOTICS_INFERENCE_PROVIDER_CONFIG:-}"
append_configuration_artifact \
  host_topology "${ROBOTICS_HOST_TOPOLOGY_CONFIG:-}"
append_configuration_artifact \
  runtime_resources "${ROBOTICS_RUNTIME_RESOURCES_CONFIG:-}"

fastdds_profile_sha256=''
if [[ -n "${FASTRTPS_DEFAULT_PROFILES_FILE:-}" && -f "${FASTRTPS_DEFAULT_PROFILES_FILE}" ]]; then
  fastdds_profile_sha256="$(sha256sum "${FASTRTPS_DEFAULT_PROFILES_FILE}" | cut -d' ' -f1)"
fi

security_enclaves="$(jq -Rc 'split(",") | map(select(length > 0))' \
  <<<"${ROBOTICS_SECURITY_ENCLAVES:-}")"
security_policy_digests="$(jq -Rc 'split(",") | map(select(length > 0))' \
  <<<"${ROBOTICS_SECURITY_POLICY_DIGESTS:-}")"

output="${1:-/run/robotics/runtime-manifest.json}"
mkdir -p "$(dirname "$output")"
template=''
temporary=''
cleanup() {
  [[ -z "${template}" ]] || rm -f -- "${template}"
  [[ -z "${temporary}" ]] || rm -f -- "${temporary}"
}
trap cleanup EXIT
template="$(mktemp "$(dirname "$output")/.runtime-input.XXXXXX")"
temporary="$(mktemp "$(dirname "$output")/.runtime-manifest.XXXXXX")"

jq -n \
  --arg runtime_id "${ROBOTICS_RUNTIME_ID}" \
  --arg generated_at "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
  --arg image_reference "${ROBOTICS_OCI_REFERENCE}" \
  --arg image_digest "${ROBOTICS_OCI_DIGEST}" \
  --arg workspace_revision "$workspace_revision" \
  --arg infra_revision "${ROBOTICS_INFRA_REVISION}" \
  --arg execution_os "$execution_os" \
  --arg execution_os_version "$execution_os_version" \
  --arg architecture "$architecture" \
  --arg kernel "$kernel" \
  --arg rmw "${rmw}" \
  --arg rmw_version "${rmw_version}" \
  --arg ros_distribution "${ROS_DISTRO}" \
  --argjson domain_id "${domain_id}" \
  --arg render_mode "${ROBOTICS_RENDER_MODE:-software}" \
  --arg renderer "${ROBOTICS_RENDERER:-software-forced}" \
  --arg target_environment "${ROBOTICS_TARGET_ENVIRONMENT:-simulation}" \
  --arg data_source "${ROBOTICS_DATA_SOURCE:-simulator}" \
  --arg plant_backend "${ROBOTICS_PLANT_BACKEND:-simulated_physics}" \
  --arg time_mode "${ROBOTICS_TIME_MODE:-simulation_realtime}" \
  --arg data_plane_profile "${ROBOTICS_DATA_PLANE_PROFILE:-standard_isolated}" \
  --arg ipc_namespace "${ROBOTICS_IPC_NAMESPACE:-container-isolated}" \
  --arg network_namespace "${ROBOTICS_NETWORK_NAMESPACE:-compose-private}" \
  --arg fastdds_profile_sha256 "$fastdds_profile_sha256" \
  --arg security_profile "${ROBOTICS_SECURITY_PROFILE:-none}" \
  --arg security_strategy "${ROBOTICS_SECURITY_STRATEGY:-none}" \
  --arg clock_basis "${ROBOTICS_CLOCK_BASIS:-ros_time}" \
  --arg clock_protocol "${ROBOTICS_CLOCK_PROTOCOL:-sim_clock}" \
  --slurpfile host_platform "${ROBOTICS_HOST_PLATFORM_FILE}" \
  --slurpfile provider_bindings "${ROBOTICS_PROVIDER_BINDINGS_FILE}" \
  --argjson evaluator_bindings "${evaluator_bindings}" \
  --argjson shm_transport "$shm_transport" \
  --argjson data_sharing "$data_sharing" \
  --argjson private_ipc "$private_ipc" \
  --argjson configuration_artifacts "$configuration_artifacts" \
  --argjson workload "$workload" \
  --argjson security_enclaves "$security_enclaves" \
  --argjson security_policy_digests "$security_policy_digests" \
  '{
    schema_version: "runtime-manifest.v1",
    runtime_id: $runtime_id,
    generated_at: $generated_at,
    execution_subject: {kind: "oci_image", locator: ("oci://" + $image_reference), digest: $image_digest},
    components: {
      contracts_revision: $workspace_revision,
      harness_revision: $workspace_revision,
      infra_revision: $infra_revision
    },
    host_platform: $host_platform[0],
    execution_platform: {
      os: $execution_os,
      os_version: $execution_os_version,
      architecture: $architecture,
      kernel: $kernel
    },
    ros: {distribution: $ros_distribution, rmw_implementation: $rmw,
      rmw_version: $rmw_version, domain_id: $domain_id},
    provider_bindings: $provider_bindings[0],
    evaluator_bindings: $evaluator_bindings,
    render: {mode: $render_mode, renderer: $renderer},
    workload: $workload,
    execution: {
      target_environment: $target_environment,
      data_source: $data_source,
      plant_backend: $plant_backend,
      time_mode: $time_mode,
      data_plane_profile: $data_plane_profile
    },
    authorization: {mode: "none"},
    data_plane: ({
      rmw_implementation: $rmw,
      ipc_namespace: $ipc_namespace,
      network_namespace: $network_namespace,
      shm_transport: $shm_transport,
      data_sharing: $data_sharing,
      private_ipc: $private_ipc
    }
    + if $fastdds_profile_sha256 == "" then {}
      else {middleware_configuration_sha256: $fastdds_profile_sha256} end),
    security: {
      profile: $security_profile,
      strategy: $security_strategy,
      enclaves: $security_enclaves,
      policy_digests: $security_policy_digests
    },
    lifecycle_states: [],
    physical_targets: [],
    clock: {
      basis: $clock_basis,
      sync_protocol: $clock_protocol,
      offset_ms: 0,
      drift_ppm: 0
    }
  }
  + if ($configuration_artifacts | length) == 0 then {}
    else {configuration_artifacts: $configuration_artifacts} end' >"$template"

"${contracts_cli}" runtime-manifest init --template "${template}" --output "${temporary}" >/dev/null
chmod 0444 "$temporary"
mv -- "$temporary" "$output"
